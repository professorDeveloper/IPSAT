<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:scrollbars="vertical"
    android:overScrollMode="always"
    android:layout_height="match_parent">
 <androidx.constraintlayout.widget.ConstraintLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent">
     <ImageView
         android:id="@+id/backgroundImage"
         android:layout_width="match_parent"
         android:layout_height="@dimen/_280sdp"
         android:scaleType="centerCrop"
         android:src="@drawable/joker_banner"
         app:layout_constraintTop_toTopOf="parent" />

     <View
         android:id="@+id/overlay"
         android:layout_width="match_parent"
         android:layout_height="@dimen/_280sdp"
         android:background="@drawable/linear_gradient_bg"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toTopOf="parent" />

     <ImageView
         android:id="@+id/backButton"
         android:layout_width="24dp"
         android:layout_height="24dp"
         android:layout_marginStart="16dp"
         android:layout_marginTop="16dp"
         android:src="@drawable/ic_arrow_back"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toTopOf="parent" />

     <androidx.cardview.widget.CardView
         android:id="@+id/moviePoster"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         app:cardBackgroundColor="?attr/colorSurface"
         android:layout_marginStart="16dp"
         android:layout_marginBottom="@dimen/_14sdp"
         app:cardCornerRadius="10dp"
         app:cardElevation="8dp"
         app:layout_constraintBottom_toBottomOf="@+id/backgroundImage"
         app:layout_constraintStart_toStartOf="parent">

         <androidx.appcompat.widget.AppCompatImageView
             android:id="@+id/ivPoster"
             android:layout_width="@dimen/_100sdp"
             app:srcCompat="@drawable/joker_banner"
             android:layout_height="@dimen/_150sdp"
             android:scaleType="centerCrop" />

     </androidx.cardview.widget.CardView>

     <!-- Movie Details Section -->
     <LinearLayout
         android:id="@+id/movieDetails"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_marginStart="16dp"
         android:orientation="vertical"
         android:layout_marginBottom="@dimen/_8sdp"
         app:layout_constraintBottom_toBottomOf="@+id/moviePoster"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintHorizontal_bias="0"
         app:layout_constraintStart_toEndOf="@id/moviePoster">

         <TextView
             android:id="@+id/movieTitle"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:fontFamily="@font/inter_bold"
             android:text="Jimmy Carr: Natural Born Killer"
             android:textSize="20sp"
             android:textStyle="bold" />

         <!-- Movie Rating -->
         <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal">

             <ImageView
                 android:id="@+id/starIcon"
                 android:layout_width="16dp"
                 android:layout_height="16dp"
                 android:layout_marginEnd="4dp"
                 android:src="@drawable/ic_star"
                 app:tint="@color/map_yellow" />

             <TextView
                 android:id="@+id/ratingText"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:fontFamily="@font/inter_bold"
                 android:layout_marginEnd="8dp"
                 android:text="6.6"
                 android:textSize="14sp" />

         </LinearLayout>

         <TextView
             android:id="@+id/releaseYear"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="4dp"
             android:fontFamily="@font/nunito_semi_bold"
             android:text="Release Year: 2024"
             android:textSize="14sp" />

         <TextView
             android:id="@+id/movieLanguage"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="4dp"
             android:text="Language: en"
             android:fontFamily="@font/inter_regular"
             android:textSize="14sp" />
     </LinearLayout>

     <com.google.android.material.button.MaterialButton
         android:id="@+id/materialButton"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:insetLeft="0dp"
         android:layout_marginTop="@dimen/_8sdp"
         android:text="Watch Now"
         android:textSize="@dimen/_14ssp"
         android:fontFamily="@font/inter_bold"
         android:layout_marginHorizontal="@dimen/_8sdp"
         android:insetTop="0dp"
         android:insetRight="0dp"
         android:insetBottom="0dp"
         app:cornerRadius="@dimen/_8sdp"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toBottomOf="@+id/backgroundImage" />

     <ScrollView
         android:id="@+id/descriptionSection"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_marginStart="16dp"
         android:layout_marginTop="@dimen/_8sdp"
         android:layout_marginEnd="16dp"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toBottomOf="@+id/materialButton">


         <TextView
             android:id="@+id/movieDescription"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:lineSpacingExtra="4dp"
             android:text="An iconic comedian tackles controversial issues such as gun control, religion, cancellation cultu..."
             android:textSize="14sp" />
     </ScrollView>

     <TextView
         android:id="@+id/similarMoviesLabel"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:layout_marginStart="16dp"
         android:text="Similar Movies"
         android:textSize="16sp"
         android:textStyle="bold"
         app:layout_constraintTop_toBottomOf="@+id/descriptionSection"
         app:layout_constraintStart_toStartOf="parent" />

     <androidx.recyclerview.widget.RecyclerView
         android:id="@+id/similarMoviesRecycler"
         android:layout_width="match_parent"
         android:paddingStart="@dimen/_4sdp"

         android:layout_height="wrap_content"
         app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
         android:orientation="horizontal"
         tools:listitem="@layout/item_movie"
         android:layout_marginTop="8dp"
         app:layout_constraintTop_toBottomOf="@+id/similarMoviesLabel"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent" />


 </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
