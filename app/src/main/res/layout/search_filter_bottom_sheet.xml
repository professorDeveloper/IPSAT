<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/bottomSheerCustomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/inter_bold"
            android:text="Filter"
            android:textAlignment="center"
            android:textSize="20sp" />


        <!-- Country Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:text="Country"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:scrollbars="horizontal"
            android:layout_height="match_parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/countryChipGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="horizontal"
                app:singleLine="true"
                android:padding="8dp"
                app:singleSelection="false" />


        </HorizontalScrollView>

        <!-- Years Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Years"
            android:textSize="16sp" />


        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/yearsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:scrollbars="vertical"
                app:singleLine="true"
                app:singleSelection="false" />

        </HorizontalScrollView>
        <!-- Categories Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Categories"
            android:textSize="16sp" />


        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoriesChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:scrollbars="vertical"
                app:singleLine="true"
                app:singleSelection="false" />

        </HorizontalScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#ABABAB" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchFilterCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Cancel"
                android:textColor="@color/white"
                app:backgroundTint="?attr/colorOnBackground"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchFilterApply"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:text="Apply"
                android:textColor="@color/white"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
