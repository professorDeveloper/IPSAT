<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_3sdp"
    android:layout_marginVertical="@dimen/_3sdp">



        <androidx.cardview.widget.CardView
            android:id="@+id/cardView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_img"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_150sdp"
                android:scaleType="centerCrop"
                android:transitionName="mediaCover"
                app:shapeAppearanceOverlay="@style/roundedImageView"
                tools:srcCompat="@tools:sample/backgrounds/scenic[4]" />

            <LinearLayout
                android:id="@+id/itemCompactScoreBG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="@drawable/item_number"
                android:backgroundTint="#BFFFFFFF"
                android:backgroundTintMode="multiply"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_6sdp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/itemCompactScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:fontFamily="@font/inter_bold"
                    android:paddingTop="@dimen/_2sdp"
                    android:layout_marginHorizontal="@dimen/_2sdp"
                    android:textColor="@color/colorAccent"
                    android:textSize="13dp"
                    tools:ignore="TextContrastCheck"
                    tools:text="0.0" />

                <com.google.android.material.imageview.ShapeableImageView

                    android:id="@+id/imageView2"
                    android:layout_width="15dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    app:tint="@color/map_yellow"
                    android:layout_marginStart="2dp"
                    android:scaleType="centerCrop"
                    android:transitionName="mediaCover"
                    app:srcCompat="@drawable/ic_star"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/title_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"
            android:singleLine="true"

            android:marqueeRepeatLimit="marquee_forever"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="@dimen/_13ssp"
            android:transitionName="mediaTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cardView2"
            app:layout_constraintTop_toBottomOf="@+id/cardView2"
            tools:text="Get Color" />

    </androidx.constraintlayout.widget.ConstraintLayout>
