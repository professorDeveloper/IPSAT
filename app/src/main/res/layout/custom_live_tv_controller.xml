<?xml version="1.0" encoding="utf-8"?><!-- Main Player Container -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/exo_black_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A8000000" />

    <FrameLayout
        android:id="@+id/exo_controller_margin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <FrameLayout
            android:id="@+id/exo_controller_cont"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="@dimen/_8sdp">

                <LinearLayout
                    android:id="@+id/exo_top_cont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_2sdp">

                    <ImageButton
                        android:id="@+id/exo_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:backgroundTint="#00FFFFFF"

                        android:src="@drawable/ic_round_arrow_back_ios_new_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/exo_anime_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="48dp"
                            android:alpha="0.66"
                            android:fontFamily="@font/inter_bold"
                            android:singleLine="false"
                            android:textColor="@color/bg_white"
                            android:textSize="@dimen/_15ssp"
                            tools:ignore="TextContrastCheck"
                            tools:text="Popular" />

                    </LinearLayout>

                    <!--                    <ImageButton-->
                    <!--                        android:id="@+id/btn_toggle_sidebar"-->
                    <!--                        android:layout_width="wrap_content"-->
                    <!--                        android:layout_height="wrap_content"-->
                    <!--                        android:backgroundTint="#00FFFFFF"-->
                    <!--                        app:srcCompat="@drawable/ic_show_program"-->
                    <!--                        app:tint="@color/bg_white"-->
                    <!--                        tools:ignore="ContentDescription,SpeakableTextPresentCheck" />-->
                    <FrameLayout
                        android:id="@+id/btn_toggle_sidebar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/_4sdp"
                        android:background="@drawable/ellipsize">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/tv_retro" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_right_toggle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/_4sdp"
                        android:background="@drawable/ellipsize">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_epg" />

                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/exo_video_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.58"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textAlignment="textEnd"
                    android:textColor="@color/bg_white"
                    android:textSize="12sp"
                    tools:ignore="TextContrastCheck"
                    tools:text="720x1080" />

                <TextView
                    android:id="@+id/exo_server_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.58"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="textEnd"
                    android:textColor="@color/bg_white"
                    android:textSize="12sp"
                    tools:ignore="TextContrastCheck"
                    tools:text="Server" />

                <TextView
                    android:id="@+id/exo_video_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:alpha="0.58"
                    android:textAlignment="textEnd"
                    android:textColor="@color/bg_white"
                    android:textSize="12sp"
                    tools:ignore="TextContrastCheck"
                    tools:text="720x1080" />

            </LinearLayout>
        </FrameLayout>

    </FrameLayout>


    <ImageView
        android:id="@+id/playBtn"
        style="@style/ExoMediaButton.Play"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_centerInParent="true"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/anim_pause_to_play"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/exo_timeline_cont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="-8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:textColor="#F1F1F1"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck"
                tools:text="00:00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=" / "
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                tools:ignore="HardcodedText,TextContrastCheck" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:textAlignment="viewEnd"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                tools:ignore="TextContrastCheck"
                tools:text="24:00" />

        </LinearLayout>

        <view
            android:id="@id/exo_progress"
            class="com.ip_tv.ipsat.presentation.activities.PlayerActivity$ExtendedTimeBar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginVertical="8dp"
            app:ad_marker_color="#A9FFFFFF"
            app:bar_height="2dp"
            app:played_color="?attr/colorPrimary"
            app:scrubber_color="?attr/colorAccent"
            tools:ignore="SpeakableTextPresentCheck" />

        <LinearLayout
            android:id="@+id/exo_bottom_cont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/exo_quality"
                    android:layout_width="48dp"

                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_high_quality_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="#fff"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/exo_pip"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_picture_in_picture_alt_24"
                    app:tint="#fff"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />


                <ImageButton
                    android:id="@+id/exo_sub"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:baselineAligned="false"
                    android:scaleX="-1"
                    android:src="@drawable/ic_round_subtitles_24"
                    android:visibility="gone"
                    app:tint="#fff"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@id/exo_playback_speed"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_slow_motion_video_24"
                    app:tint="#fff"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@id/exo_rotate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_screen_rotation_alt_24"
                    app:tint="#fff"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/exo_screen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="#00FFFFFF"
                    android:src="@drawable/ic_round_fullscreen_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />


            </LinearLayout>
        </LinearLayout>

    </LinearLayout>


</RelativeLayout>