<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/prem_bg"
    android:layout_marginHorizontal="@dimen/_4sdp"
    android:layout_marginVertical="@dimen/_3sdp"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="@dimen/_5sdp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/castImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/joker_banner"
            android:transitionName="characterCover"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />


        <TextView
            android:id="@+id/castName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_4sdp"
            android:ellipsize="marquee"
            android:fontFamily="@font/inter_bold"
            android:lines="1"

            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="JokerJokerJoker"
            android:textSize="@dimen/_11ssp"
            android:transitionName="mediaTitle" />

        <TextView
            android:id="@+id/castCharacter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="marquee"
            android:fontFamily="@font/inter_bold"
            android:lines="1"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="JokerJokerJoker"
            android:textSize="10sp"
            android:transitionName="mediaTitle" />


    </LinearLayout>


</androidx.cardview.widget.CardView>