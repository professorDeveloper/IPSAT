<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.screens.ProfileScreen">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:background="@color/prem_bg"

        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/subscriptionBtn"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/refund" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subscription Details"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_11ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/subscriptionUpdateInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginHorizontal="@dimen/_24sdp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Info"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subscriptionSettings"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/settings"
                app:tint="@color/white_and_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>


    </LinearLayout>


    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:divider="@drawable/table_row_divider"
        android:elevation="4dp"
        android:padding="@dimen/_4sdp"
        android:showDividers="middle"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Code:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/subscriptionCodeTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="2"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="886601525947"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_13ssp"
                android:textStyle="italic" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Status:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/subscriptionStatusTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="2"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="Active"
                android:textColor="@color/map_green"
                android:textSize="@dimen/_13ssp"
                android:textStyle="normal" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Activated Date:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/subscriptionActivatedDateTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="2"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="2024-12-18"
                android:textColor="@color/map_green"
                android:textSize="@dimen/_13ssp"
                android:textStyle="normal" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="End Date:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/subscriptionEndDateTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="2"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="2024-12-19"
                android:textColor="@color/map_red"
                android:textSize="@dimen/_13ssp"
                android:textStyle="normal" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Mac Address:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <TextView
                android:id="@+id/macAddressTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="2"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:singleLine="true"
                android:text="a8:25:28:b9:dd:74"
                android:textSize="@dimen/_13ssp"
                android:textStyle="normal" />
        </TableRow>


    </TableLayout>

    <TableLayout
        android:id="@+id/shimmerTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:clipToPadding="false"
        android:divider="@drawable/table_row_divider"
        android:elevation="4dp"
        android:padding="@dimen/_4sdp"
        android:showDividers="middle"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/table_row_divider"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Code:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:text="CODE Loading"
                    android:textColor="@color/white_and_black"
                    android:textSize="@dimen/_12ssp" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Status:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:text="STATUS Loading"
                    android:textColor="@color/white_and_black"
                    android:textSize="@dimen/_12ssp" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Activated Date:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/activatedDateShimmer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:text="DATE Loading"
                    android:textColor="@color/white_and_black"
                    android:textSize="@dimen/_12ssp" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="End Date:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/endDateShimmer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:text="END DATE Loading"
                    android:textColor="@color/white_and_black"
                    android:textSize="@dimen/_12ssp" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_2sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:gravity="start"
                android:text="Mac Address:"
                android:textColor="@color/white_and_black"
                android:textSize="@dimen/_12ssp" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/macAddressShimmer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="start"
                    android:text="Mac Address Loading"
                    android:textColor="@color/white_and_black"
                    android:textSize="@dimen/_12ssp" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </TableRow>


    </TableLayout>


</androidx.constraintlayout.widget.ConstraintLayout>